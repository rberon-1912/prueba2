#include <stdio.h>

#define MAX 1000

int main() {
    float vector[MAX];
    int cantidad = 0;
    float numero;

    printf("Ingrese numeros reales (finaliza con 0):\n");

    // Entrada de datos
    do {
        scanf("%f", &numero);

        if (numero != 0 && cantidad < MAX) {
            vector[cantidad] = numero;
            cantidad++;
        }

    } while (numero != 0 && cantidad < MAX);

    // Mostrar resultados
    printf("\nCantidad de numeros ingresados: %d\n", cantidad);

    printf("\nContenido del vector:\n");

    for (int i = 0; i < cantidad; i++) {
        printf("Posicion %d: %.2f\n", i + 1, vector[i]);
    }

    return 0;
}